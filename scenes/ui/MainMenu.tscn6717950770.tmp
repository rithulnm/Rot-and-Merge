[sub_resource type="GDScript" id="GDScript_xpiny"]
script/source = "extends Camera2D
var bulb_angle := 0.0
var bulb_vel := 0.0
const SPRING := 0.008
const DAMPEN := 0.97

var time := 0.0

func _process(delta):

	time += delta

	offset.x = sin(time * 0.5) * 8.0
	offset.y = cos(time * 0.4) * 5.0
"

